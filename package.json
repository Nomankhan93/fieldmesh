{
  "name": "fieldmesh",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "tsc -b && vite build && vitest run",
    "test": "vitest run",
    "env:local": "node scripts/write-local-env.mjs",
    "test:local": "node scripts/test-identity-auth-rules.mjs && node scripts/test-authorization-integrity.mjs && node scripts/test-durable-messaging.mjs && node scripts/test-groups-permissions.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "test:messaging": "node scripts/test-durable-messaging.mjs",
    "test:architecture": "vitest run src/core/message/model.test.ts src/core/transport/frame.test.ts src/transports/router.test.ts src/core/message/codec.test.ts src/core/delivery/coordinator.test.ts src/core/delivery/internetAdapter.test.ts src/core/workspace/model.test.ts",
    "test:mesh": "vitest run src/core/mesh/simulator.test.ts src/features/simulator/simulatorView.test.ts",
    "test:gateway": "vitest run src/core/gateway/agent.test.ts",
    "test:sos": "vitest run src/core/location/location.test.ts src/core/sos/codec.test.ts src/core/sos/service.test.ts src/core/message/model.test.ts",
    "test:ui": "vitest run src/features/shell/navigation.test.ts src/features/contacts/contactCode.test.ts src/features/network/networkStatus.test.ts src/core/groups/permissions.test.ts src/features/mobile/model.test.ts",
    "test:groups": "node scripts/test-groups-permissions.mjs",
    "test:crypto": "vitest run src/core/crypto/envelope.test.ts src/core/groups/permissions.test.ts",
    "test:authz": "node scripts/test-authorization-integrity.mjs",
    "test:delivery": "vitest run src/core/delivery/coordinator.test.ts src/core/delivery/internetAdapter.test.ts",
    "test:workspace": "vitest run src/core/workspace/model.test.ts src/features/shell/navigation.test.ts",
    "test:pwa": "vitest run src/features/pwa/model.test.ts src/config/brand.test.ts",
    "test:mobile": "vitest run src/features/mobile/model.test.ts src/features/shell/navigation.test.ts src/config/brand.test.ts",
    "test:sync-reliability": "vitest run src/core/workspace/syncPolicy.test.ts src/core/workspace/model.test.ts src/core/delivery/coordinator.test.ts src/core/delivery/internetAdapter.test.ts",
    "test:messenger-ui": "vitest run src/features/messaging/messengerUi.test.ts src/features/mobile/model.test.ts src/features/shell/navigation.test.ts",
    "test:mobile-ux": "vitest run src/features/mobile/informationHierarchy.test.ts src/features/mobile/model.test.ts src/features/messaging/messengerUi.test.ts src/features/shell/navigation.test.ts src/config/brand.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
